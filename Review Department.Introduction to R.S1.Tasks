
# Session 1 - Task 1: Exam Scores
# R Programming for Neuroscience

# Name: Hamid Reza Ghahramani

# Questions:
#
# Task 1 - Exam Scores
#
# exam1 <- c(15, 22, 18, 30, 25, 10, 28, 17, 20, 27, 23, 19)
# exam2 <- c(18, 24, 21, 29, 26, 12, 30, 19, 22, 28, 25, 20)
#
# Instructions:
#
# 1. Compute average score for each student.
#
# 2. Identify top students:
#    - Scores > 25 in both exams
#    - Scores < 20 in either exam
#
# 3. Select 3rd, 5th, 8th students from Exam1.
#
# 4. Select last 4 students from Exam2.
#
# 5. Select students with average > 24.
#
# 6. Update 6th student Exam1 score to 21.
#
# 7. Correct 10th student Exam2 score from 28 to 26.
#
# ==================================================
# Answers
# ==================================================

# 1. Create vectors
exam1 <- c(15, 22, 18, 30, 25, 10, 28, 17, 20, 27, 23, 19)

exam2 <- c(18, 24, 21, 29, 26, 12, 30, 19, 22, 28, 25, 20)

# 2. Compute average score for each student
average <- (exam1 + exam2) / 2
print(average)

# 3. Students scoring above 25 in both exams
print(which(exam1 > 25 & exam2 > 25))

# Students scoring below 20 in either exam
print(which(exam1 < 20 | exam2 < 20))

# 4. Select 3rd, 5th, and 8th students from Exam1
print(exam1[c(3, 5, 8)])

# 5. Select the last 4 students from Exam2
print(tail(exam2, 4))

# 6. Select students with average score above 24
print(which(average > 24))

# 7. Update the 6th student's Exam1 score to 21
exam1[6] <- 21

# 8. Correct the 10th student's Exam2 score from 28 to 26
exam2[10] <- 26

# 9. Recalculate average scores after updates
average <- (exam1 + exam2) / 2
print(average)

# 10. Display updated exam scores
print(exam1)
print(exam2)

# 11. Check conditions again after updates
print(which(exam1 > 25 & exam2 > 25))
print(which(exam1 < 20 | exam2 < 20))
print(which(average > 24))
